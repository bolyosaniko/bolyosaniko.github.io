---
import { Image } from "astro:assets";

import Slides from "./slides.astro";

import bhf0 from "../assets/images/photos/bhf_1.jpg";
import bhf1 from "../assets/images/photos/bhf_slide_1.png";
import bhf2 from "../assets/images/photos/bhf_slide_2.png";
import bhf3 from "../assets/images/photos/bhf_slide_3.jpg";
---

<Slides id="bhf-slides">
    <div class="min-w-full w-full justify-items-center">
        <Image class="max-h-[500px] w-auto" src={bhf0} alt="" />
    </div>
    <div class="min-w-full w-full justify-items-center">
        <Image class="max-h-[500px] w-auto" src={bhf1} alt="" />
    </div>
    <div class="min-w-full w-full justify-items-center">
        <Image class="max-h-[500px] w-auto" src={bhf2} alt="" />
    </div>
    <div class="min-w-full w-full justify-items-center">
        <Image class="max-h-[500px] w-auto" src={bhf3} alt="" />
    </div>
</Slides>

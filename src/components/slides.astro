---
const {
    id,
} = Astro.props;

const idSlidesWrapper = "slides-wrapper-"+id;
const idSlideBtnPrevious = "slide-btn-prev-"+id;
const idSlideBtnNext = "slide-btn-next-"+id;
const idSlidesContainer = "slides-container-"+id;
const idSlidesDots = "slides-dots-"+id;
---

<section id={idSlidesWrapper} class="relative mx-auto w-[80%] overflow-hidden" data-slides>
    <div id={idSlidesContainer} class="slides-container flex h-auto transition-transform">
        <slot />
    </div>
    <div class="flex items-center justify-center gap-4 my-4">
        <button id={idSlideBtnPrevious} type="button" aria-label="Previous slide" class="inline-flex rounded-full items-center justify-center bg-white size-8 md:size-16 opacity-50 hover:opacity-100 transition-opacity">
            <svg class="size-4 md:size-8" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 1 1 5l4 4"/>
            </svg>
        </button>
        <div id={idSlidesDots} class="dots-container flex items-center justify-center">
        </div>
        <button id={idSlideBtnNext} type="button" aria-label="Next slide" class="inline-flex rounded-full items-center justify-center bg-white size-8 md:size-16 opacity-50 hover:opacity-100 transition-opacity">
            <svg class="size-4 md:size-8" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
            </svg>
        </button>
    </div>
</section>

<script>
    // @ts-nocheck
    function initializeSlide(slidesWrapper) {
        if (slidesWrapper.dataset.initialized === "true") return;

        const slidesContainer = slidesWrapper.querySelector(".slides-container");
        const prevButton = slidesWrapper.querySelector("button:first-of-type");
        const nextButton = slidesWrapper.querySelector("button:last-of-type");
        const dotsContainer = slidesWrapper.querySelector(".dots-container");

        if (!(slidesContainer instanceof HTMLElement) || !(prevButton instanceof HTMLButtonElement) ||
            !(nextButton instanceof HTMLButtonElement) || !(dotsContainer instanceof HTMLElement)) {
            return;
        }

        slidesWrapper.dataset.initialized = "true";
        const slides = Array.from(slidesContainer.children);
        let currentIndex = 0;
        const dots = [];

        function render() {
            let offset = 0;
            slides.forEach((slide, index) => {
                if (index < currentIndex) {
                    offset += slide.offsetWidth;
                }
            });

            slidesContainer.style.transform = `translateX(-${offset}px)`;
            dots.forEach((dot, index) => {
                dot.classList.toggle("bg-bittersweet", index === currentIndex);
                dot.classList.toggle("bg-onyx", index !== currentIndex);
            });
        }

        function goto(newIndex) {
            if (newIndex < 0 || newIndex > slides.length - 1) return;
            currentIndex = newIndex;
            render();
        }

        slides.forEach((_, index) => {
            const dot = document.createElement("button");
            dot.type = "button";
            dot.classList.add("size-2", "mx-1", "cursor-pointer", "rounded-lg", "bg-onyx", "transition-colors");
            dot.setAttribute("aria-label", `Go to slide ${index + 1}`);
            dot.addEventListener("click", () => goto(index));
            dotsContainer.appendChild(dot);
            dots.push(dot);
        });

        prevButton.addEventListener("click", () => {
            goto(currentIndex - 1);
        });
        nextButton.addEventListener("click", () => {
            goto(currentIndex + 1);
        });

        if (typeof ResizeObserver !== "undefined") {
            new ResizeObserver(render).observe(slidesContainer);
        } else {
            window.addEventListener("resize", render);
        }

        requestAnimationFrame(render);
        window.addEventListener("load", render, { once: true });
    }

    function initializeSlides() {
        document.querySelectorAll("[data-slides]").forEach((slidesWrapper) => {
            if (slidesWrapper instanceof HTMLElement) {
                initializeSlide(slidesWrapper);
            }
        });
    }

    initializeSlides();
    document.addEventListener("astro:page-load", initializeSlides);
</script>
